APP_NAME=Application Name
APP_KEY=secret
PORT=4000
APP_URL=http://localhost:${PORT}
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true

CLIENT_APP_URL=http://localhost:3000
SESSION_SECRET=secret
JWT_SECRET=secret
JWT_EXPIRY=86400000

DATABASE_URL="postgresql://postgres:root@127.0.0.1:5432/testdb?schema=public"

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Admin"

THROTTLE_SHORT_LIMIT=15
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_LIMIT=300

# Social login (mobile only)
# Google: allowed audiences for verifying the Google `idToken` (aud claim)
GOOGLE_ANDROID_APP_ID=
GOOGLE_IOS_APP_ID=
# Or provide multiple audiences comma-separated:
GOOGLE_MOBILE_APP_IDS=

# Apple: allowed audiences for verifying the Apple `identityToken` (aud claim)
# Commonly your iOS Bundle ID (e.g. com.example.app)
APPLE_CLIENT_ID=
# Optionally provide multiple audiences comma-separated:
APPLE_MOBILE_CLIENT_IDS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=https://s3.us-east-2.amazonaws.com

GCP_PROJECT_ID=
GCP_KEY_FILE=
GCP_API_ENDPOINT=
GCP_BUCKET=

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXX

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=


# system user
SYSTEM_USERNAME=admin
SYSTEM_EMAIL=admin@example.com
SYSTEM_PASSWORD=12356

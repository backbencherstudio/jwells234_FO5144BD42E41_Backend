NODE_ENV=production
PORT=4000
APP_NAME=Silent Whistle App
APP_KEY=replace-with-strong-random-value
APP_URL=https://api.example.com
CLIENT_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com
SWAGGER_ENABLED=false

SESSION_SECRET=replace-with-strong-random-value
JWT_SECRET=replace-with-strong-random-value
JWT_EXPIRY=86400000

POSTGRES_USER=silent_whistle
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=silent_whistle_db
DATABASE_URL=postgresql://silent_whistle:replace-with-strong-password@postgres:5432/silent_whistle_db?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

THROTTLE_SHORT_LIMIT=15
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_LIMIT=300

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace@example.com
MAIL_PASSWORD=replace-app-password
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Silent Whistle
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin

# Web OAuth
GOOGLE_APP_ID=
GOOGLE_APP_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
APPLE_PRIVATE_KEY=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_CALLBACK_URL=https://api.example.com/api/auth/apple/callback

# Mobile OAuth
GOOGLE_ANDROID_APP_ID=
GOOGLE_IOS_APP_ID=
GOOGLE_MOBILE_APP_IDS=
APPLE_CLIENT_ID=
APPLE_MOBILE_CLIENT_IDS=

# Storage
STORAGE_DRIVER=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GCP_PROJECT_ID=
GCP_KEY_FILE=
GCP_API_ENDPOINT=
GCP_BUCKET=

GOOGLE_MAPS_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=

SUBSCRIPTION_TRIAL_DAYS=14

SYSTEM_USERNAME=administrator
SYSTEM_EMAIL=admin@example.com
SYSTEM_PASSWORD=replace-with-strong-password
